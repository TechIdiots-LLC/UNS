<?xml version="1.0" encoding="UTF-8"?>
<!--
    IIS counterpart to the .htaccess in this folder. IIS ignores .htaccess entirely and
    Apache ignores web.config, so both are shipped and each server reads only its own.

    This folder lives inside the site root, so a SQLite database created here by
    install.php would otherwise be downloadable over HTTP - handing out every password
    hash and session hash in the install. UNS puts the database outside the web root by
    default; this only matters when no such location was available.

    Only the database file types are blocked, not the whole folder, because the .css
    files in here are loaded by the browser and must stay reachable. conn.php and
    vars.php are executed by PHP rather than served, so they are not exposed this way.

    requestFiltering is part of the base IIS 7+ install, so this needs no extra role
    service. It returns 404.7 for a blocked request.
-->
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>
                <fileExtensions>
                    <add fileExtension=".sqlite" allowed="false" />
                    <add fileExtension=".sqlite3" allowed="false" />
                    <add fileExtension=".sqlite-wal" allowed="false" />
                    <add fileExtension=".sqlite-shm" allowed="false" />
                    <add fileExtension=".sqlite-journal" allowed="false" />
                    <add fileExtension=".db" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
